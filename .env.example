# Copy to .env for local development. Never commit .env.
# All values below are LOCAL DEVELOPMENT placeholders, not real credentials.

# --- Database (local Postgres/PostGIS from docker-compose) ---
POSTGRES_USER=hydrosight
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=hydrosight
DATABASE_URL=postgresql://hydrosight:change-me-local-only@db:5432/hydrosight

# --- API service ---
API_ENV=development
API_PORT=8000

# --- Web app ---
WEB_PORT=3000
# Where the web server reaches the API (inside docker-compose network)
API_INTERNAL_URL=http://api:8000

# --- Added in later phases (leave empty for now) ---
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SMS_PROVIDER=sandbox
# EMAIL_PROVIDER=sandbox
# ANTHROPIC_API_KEY=

# Ingestion rate limits, requests per minute (operational settings, see docs/SECURITY_REVIEW.md)
RATE_LIMIT_PER_KEY_PER_MIN=120
RATE_LIMIT_GLOBAL_PER_MIN=3000
